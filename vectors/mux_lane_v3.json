{
  "primitive": "mux-lane",
  "version": 3,
  "channels": [
    {"channel_id": "ch-chat", "surface": "now.chat.message.normal", "backend": "ipoll", "allowed_intents": ["chat", "task"]},
    {"channel_id": "ch-vpn", "surface": "now.vpn.tunnel.normal", "backend": "overlay", "allowed_intents": ["vpn:tunnel"]}
  ],
  "cases": [
