    },
    {
      "name": "unknown-channel",
      "frame": {"channel_id": "ch-missing", "surface": "now.chat.message.normal", "intent": "chat"},
      "expect_deliver": false
    },
    {
      "name": "vpn-on-vpn-lane",
      "frame": {"channel_id": "ch-vpn", "surface": "now.vpn.tunnel.normal", "intent": "vpn:tunnel"},
      "expect_deliver": true
    }
  ]
